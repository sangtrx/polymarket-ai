# Polymarket Rust Trading System - Placeholder secrets/config
# Fill these locally; never commit real values.

# Core CLOB auth (user)
POLYMARKET_PRIVATE_KEY=your_polygon_private_key
POLY_API_KEY=your_poly_api_key
POLY_API_SECRET=your_poly_api_secret
POLY_API_PASSPHRASE=your_poly_api_passphrase
POLYMARKET_FUNDER_ADDRESS=your_funder_address
POLYMARKET_SIGNATURE_TYPE=2

# Builder program (optional, for attribution + gasless relayer flows)
POLY_BUILDER_API_KEY=your_builder_api_key
POLY_BUILDER_SECRET=your_builder_secret
POLY_BUILDER_PASSPHRASE=your_builder_passphrase

# Relayer API key alternative (optional)
RELAYER_API_KEY=your_relayer_api_key
RELAYER_API_KEY_ADDRESS=your_relayer_key_owner_address

# Service endpoints
CLOB_HOST=https://clob.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
RELAY_HOST=https://relayer-v2.polymarket.com/
