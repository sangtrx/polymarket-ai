# ---------------------------------------------------------------------------
# Global runtime defaults (least privilege)
# ---------------------------------------------------------------------------
RUNTIME_RUN_AS_NON_ROOT=true
RUNTIME_UID=10001
RUNTIME_GID=10001

# ---------------------------------------------------------------------------
# Control API
# ---------------------------------------------------------------------------
CONTROL_API_BIND_ADDRESS=127.0.0.1
CONTROL_API_PORT=8080
CONTROL_API_JWT_ISSUER=REPLACE_AT_RUNTIME_ISSUER
CONTROL_API_JWT_AUDIENCE=operator-console
CONTROL_API_JWKS_URL=REPLACE_AT_RUNTIME_URL

# ---------------------------------------------------------------------------
# Execution Engine + Risk Engine
# ---------------------------------------------------------------------------
EXECUTION_POLYMARKET_API_BASE_URL=https://clob.polymarket.com
EXECUTION_POLYMARKET_PRIVATE_KEY=REPLACE_AT_RUNTIME_SECRET
EXECUTION_POLYMARKET_API_KEY=REPLACE_AT_RUNTIME_SECRET
EXECUTION_POLYMARKET_API_SECRET=REPLACE_AT_RUNTIME_SECRET
EXECUTION_POLYMARKET_API_PASSPHRASE=REPLACE_AT_RUNTIME_SECRET
EXECUTION_POLYMARKET_ADDRESS=REPLACE_AT_RUNTIME_ADDRESS
EXECUTION_POLYMARKET_CHAIN_ID=137
EXECUTION_USER_STREAM_ENABLED=false
EXECUTION_USER_STREAM_NAME=polymarket_user_stream
EXECUTION_USER_STREAM_ENDPOINT=wss://ws-subscriptions-clob.polymarket.com
EXECUTION_USER_STREAM_MARKET_IDS=REPLACE_AT_RUNTIME_MARKET_IDS
EXECUTION_USER_STREAM_RECONNECT_BACKOFF_SECONDS=1
EXECUTION_USER_STREAM_MAX_RECONNECT_ATTEMPTS=5
EXECUTION_FRESHNESS_EVALUATION_INTERVAL_SECONDS=1
EXECUTION_FRESHNESS_STALE_THRESHOLD_SECONDS=30
EXECUTION_FRESHNESS_STABILITY_WINDOW_SECONDS=10
EXECUTION_FRESHNESS_MAX_BREACH_TO_PAUSE_SECONDS=5
RISK_DEFAULT_MODE=monitor
RISK_MAX_ORDER_NOTIONAL_USD=1000

# ---------------------------------------------------------------------------
# Operator Console
# ---------------------------------------------------------------------------
OPERATOR_CONSOLE_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
OPERATOR_CONSOLE_SENTRY_DSN=REPLACE_AT_RUNTIME_SECRET
OPERATOR_CONSOLE_FEATURE_FLAGS=REPLACE_AT_RUNTIME_FLAGS

# ---------------------------------------------------------------------------
# Operator BFF (Track A orchestration only)
# ---------------------------------------------------------------------------
OPERATOR_BFF_PORT=8090
OPERATOR_BFF_AUTH_SECRET=REPLACE_AT_RUNTIME_SECRET
OPERATOR_BFF_DATABASE_URL=REPLACE_AT_RUNTIME_URL
CONTROL_API_BASE_URL=http://127.0.0.1:8080
